---
// Photo wall: white-framed, slightly tilted prints with orange place stickers that link to the package.
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getSite } from '../lib/site';
import { photo } from '../lib/images';

const site = await getSite();
const g = site.gallerySection;
const items = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const tilts = ['-2deg', '1.5deg', '-1deg', '2.5deg', '1.5deg', '-2.5deg', '2deg', '-1.5deg'];
---
<section class="gallery" id="gallery" aria-labelledby="ga-title">
  <div class="sec-head">
    <h2 class="display" id="ga-title">{g.titleTop}<br><span>{g.titleBottom}</span></h2>
    <p>{g.intro}</p>
  </div>

  <ul class="wall">
    {items.map((item, i) => (
      <li class="print" style={`--tilt: ${tilts[i % tilts.length]}`}>
        <figure>
          <Picture
            src={photo(item.data.src)}
            alt={item.data.alt}
            formats={['webp']}
            widths={[360, 540, 720, 960]}
            sizes="(max-width: 560px) calc(100vw - 60px), (max-width: 1100px) 45vw, 30vw"
            quality={72}
          />
          <figcaption><a href={`#pkg-${item.data.package}`}>{item.data.place}<span class="sr-only">: see the package</span></a></figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery { background: var(--navy); color: var(--white); padding: var(--section-top) var(--gutter) var(--section-bottom); overflow: hidden; }
  .gallery h2 { color: var(--white); }
  .gallery h2 span { color: var(--yellow); }
  .gallery .sec-head p { color: var(--on-navy-soft); }

  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.1fr 1fr 1fr 1.1fr; grid-template-rows: repeat(3, 270px); gap: 36px 32px;
    grid-template-areas: "a b b c" "a d e c" "f g g h"; }
  .print:nth-child(1) { grid-area: a; } .print:nth-child(2) { grid-area: b; } .print:nth-child(3) { grid-area: c; } .print:nth-child(4) { grid-area: d; }
  .print:nth-child(5) { grid-area: e; } .print:nth-child(6) { grid-area: f; } .print:nth-child(7) { grid-area: g; } .print:nth-child(8) { grid-area: h; }
  /* The list item is the steady hover target; only the print inside it tilts and lifts, so it can't slip out from under the cursor. */
  .print figure { position: relative; margin: 0; height: 100%; background: var(--white); padding: 10px; border-radius: 22px; box-shadow: 0 24px 50px rgba(0,0,0,.4);
    rotate: var(--tilt); transition: rotate .7s var(--ease), translate .7s var(--ease), box-shadow .7s var(--ease); }
  .print:hover figure, .print:focus-within figure { rotate: 0deg; translate: 0 -6px; box-shadow: 0 32px 60px rgba(0,0,0,.45); }
  .print :global(picture) { display: contents; }
  .print :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; }
  .print figcaption { position: absolute; left: -8px; bottom: 22px; }
  .print figcaption a { transition: background-color .25s; display: inline-block; font-weight: 800; font-variation-settings: "wdth" 75, "opsz" 96; text-transform: uppercase; font-size: 24px; line-height: 1; letter-spacing: -.01em; text-decoration: none; background: var(--orange); color: var(--navy); padding: 9px 16px 8px; border-radius: 12px; rotate: -4deg; box-shadow: 0 10px 22px rgba(0,0,0,.3); }
  .print figcaption a:hover { background: var(--yellow); }
  .gallery :focus-visible { outline-color: var(--yellow); }

  @media (max-width: 1100px) {
    .wall { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 260px; grid-template-areas: none; }
    .print:nth-child(n) { grid-area: auto; }
  }
  @media (max-width: 560px) {
    .wall { grid-template-columns: 1fr; grid-auto-rows: 240px; gap: 28px; padding: 0 6px; }
    .print:nth-child(n) figure { rotate: calc(var(--tilt) * .6); }
    .print figcaption a { font-size: 21px; }
  }
</style>
