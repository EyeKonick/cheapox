---
// Address + directions on a yellow ticket, and every way to reach CheaPOX as big tap targets.
import Icon, { type IconName } from './Icon.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const { contact, address } = site;
const c = site.contactSection;
const mobileDigits = contact.mobileE164.slice(1);

const channels: { label: string; value: string; href: string; icon: IconName; external?: boolean; wide?: boolean }[] = [
  { label: 'Call mobile', value: contact.mobile, href: `tel:${contact.mobileE164}`, icon: 'phone' },
  { label: 'Call landline', value: contact.landline, href: `tel:${contact.landlineE164}`, icon: 'phone' },
  { label: 'WhatsApp', value: contact.mobile, href: `https://wa.me/${mobileDigits}`, icon: 'chat', external: true },
  { label: 'Viber', value: contact.mobile, href: `viber://chat?number=%2B${mobileDigits}`, icon: 'viber' },
  { label: 'Message us on Facebook', value: contact.facebookName, href: contact.facebookUrl, icon: 'messenger', external: true },
  { label: 'Instagram', value: `@${contact.instagramHandle}`, href: contact.instagramUrl, icon: 'instagram', external: true },
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}`, icon: 'mail', wide: true },
];
const ext = (on?: boolean) => (on ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="contact" id="contact" aria-labelledby="ct-title">
  <div class="sec-head">
    <h2 class="display" id="ct-title">{c.titleTop}<br><span>{c.titleBottom}</span></h2>
    <p>{c.intro}</p>
  </div>

  <div class="contact__grid">
    <div class="ticket">
      <address class="ticket__addr">
        <span class="display">{address.street}</span>
        {address.locality}, {address.region} {address.postalCode}, Philippines
      </address>
      <p class="ticket__hours"><Icon name="clock" /> <span><b>Hours</b> {contact.hours}</span></p>
      <div class="actions">
        <a class="btn btn--primary" href={contact.mapsUrl} target="_blank" rel="noopener">Get Directions <Icon name="arrow" strokeWidth={2.2} /></a>
        <a class="btn btn--ghost" href={contact.facebookUrl} {...ext(true)}>Message us on Facebook</a>
      </div>
    </div>

    <ul class="channels">
      {channels.map((ch) => (
        <li class:list={{ wide: ch.wide }}>
          <a href={ch.href} {...ext(ch.external)}>
            <span class="channels__icon"><Icon name={ch.icon} /></span>
            <span class="channels__label">{ch.label}</span>
            <span class="channels__value">{ch.value}</span>
            <Icon name="arrow" class="channels__go" strokeWidth={2.2} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact { background: var(--white); padding: var(--section-top) var(--gutter) var(--section-bottom); }
  .contact h2 span { color: var(--orange); }
  .contact__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 56px; align-items: start; }

  .ticket { position: relative; background: var(--yellow); border-radius: 32px; padding: 44px 44px 40px; rotate: -1.2deg; box-shadow: 0 30px 60px rgba(120,80,0,.22); }
  .ticket::before, .ticket::after { content: ""; position: absolute; top: 50%; width: 36px; height: 36px; translate: 0 -50%; border-radius: 50%; background: var(--white); }
  .ticket::before { left: -18px; } .ticket::after { right: -18px; }
  .ticket__addr { font-style: normal; font-size: 19px; font-weight: 600; line-height: 1.45; margin-bottom: 24px; }
  .ticket__addr .display { display: block; font-size: 52px; margin-bottom: 10px; }
  .ticket__hours { display: flex; align-items: center; gap: 10px; margin: 0 0 32px; padding-top: 20px; border-top: 2.5px dashed rgba(20,32,74,.25); font-size: 17px; }
  .ticket__hours :global(svg) { width: 20px; height: 20px; flex: none; }
  .ticket__hours b { margin-right: 8px; }

  /* contact channels: a departures-style list, not a tile grid */
  .channels { list-style: none; margin: 0; padding: 0; border-top: 2.5px dashed rgba(20,32,74,.22); }
  .channels li { border-bottom: 2.5px dashed rgba(20,32,74,.22); }
  .channels a { display: grid; grid-template-columns: 44px 170px 1fr 22px; align-items: center; column-gap: 18px; padding: 16px 6px; text-decoration: none; border-radius: 12px; transition: background-color .25s, padding .35s var(--spring); }
  .channels a:hover { background: var(--yellow-soft); padding-left: 14px; }
  .channels__icon { display: grid; place-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--navy); color: var(--yellow); }
  .channels__icon :global(svg) { width: 20px; height: 20px; }
  .channels__label { font-size: 15px; font-weight: 700; color: var(--ink-soft); }
  .channels__value { font-weight: 800; font-variation-settings: "wdth" 80, "opsz" 96; font-size: 26px; line-height: 1.1; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .channels :global(.channels__go) { width: 20px; height: 20px; color: var(--orange); transition: translate .35s var(--spring); }
  .channels a:hover :global(.channels__go) { translate: 4px 0; }

  @media (max-width: 1100px) {
    .contact__grid { grid-template-columns: 1fr; gap: 48px; }
    .ticket { max-width: 640px; }
  }
  @media (max-width: 560px) {
    .ticket { padding: 36px 24px 28px; rotate: -.8deg; }
    .ticket__addr .display { font-size: 40px; }
    .ticket .btn { width: 100%; justify-content: center; }
    .channels a { grid-template-columns: 40px 1fr 20px; grid-template-rows: auto auto; row-gap: 2px; padding: 14px 4px; }
    .channels__icon { grid-row: span 2; width: 40px; height: 40px; }
    .channels__label { grid-column: 2; font-size: 13.5px; }
    .channels__value { grid-column: 2; font-size: 22px; }
    .channels :global(.channels__go) { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
