---
// One authored icon set: 24px grid, 2px strokes (the star is the only filled glyph, from the approved marquee).
export type IconName = 'arrow' | 'phone' | 'mail' | 'star' | 'pin' | 'chat' | 'viber' | 'messenger' | 'instagram' | 'menu' | 'close' | 'clock' | 'check' | 'ship';
interface Props { name: IconName; class?: string; strokeWidth?: number }
const { name, class: className, strokeWidth = 2 } = Astro.props;
---
{name === 'star' ? (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 6.9L22 9.3l-5.8 4.6L18.2 21 12 17l-6.2 4 2-7.1L2 9.3l7.4-.4z"/></svg>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} aria-hidden="true">
    {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
    {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
    {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
    {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
    {name === 'chat' && <><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 19l-4.1.5z" /><path d="M9.5 9.2c0 2.8 2.5 5.3 5.3 5.3l.9-1.4-2-1-1 .8a4 4 0 0 1-1.6-1.6l.8-1-1-2-1.4.9z" /></>}
    {name === 'viber' && <><path d="M7 20.5V17a7.5 7.5 0 1 1 4 1.2H9.5z" /><path d="M10 7.5h.5a1 1 0 0 1 1 .8l.3 1.3-1 .8a5 5 0 0 0 2.8 2.8l.8-1 1.3.3a1 1 0 0 1 .8 1v.5" /></>}
    {name === 'messenger' && <><path d="M12 3c5 0 9 3.6 9 8.2s-4 8.2-9 8.2a10 10 0 0 1-2.8-.4L5.5 21v-3.5A7.9 7.9 0 0 1 3 11.2C3 6.6 7 3 12 3z" /><path d="m7.5 13.5 3-3.2 2.2 2 3.8-2.8-3 3.3-2.2-2z" /></>}
    {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></>}
    {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
    {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
    {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7" />}
    {name === 'ship' && <><path d="M3 15.5l1.6 4.5h14.8l1.6-4.5L12 12z" /><path d="M6 14.2V9h12v5.2M9.5 9V6h5v3M12 12v8" /></>}
  </svg>
)}
